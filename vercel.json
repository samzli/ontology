{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "main.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/main.py"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/snapshot-sync",
      "schedule": "0 3 * * *"
    }
  ]
}