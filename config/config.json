{
  "system_name": "Onti",
  "version": "2.1.0",
  "description": "Onti: insurance ontology workspace — rules + AI Q&A.",
  "server": {
    "host": "0.0.0.0",
    "port": 8010
  },
  "runtime": {
    "run_log": "data/run_log.jsonl",
    "run_log_max_entries": 5000
  },
  "security": {
    "session_days": 7,
    "allow_registration": true,
    "upload_max_mb": 10,
    "allowed_upload_ext": [
      ".csv",
      ".xlsx",
      ".xls",
      ".json",
      ".txt"
    ]
  }
}