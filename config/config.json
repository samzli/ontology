{
  "system_name": "Onti",
  "version": "2.1.0",
  "description": "Onti: insurance ontology workspace — rules + AI Q&A.",
  "server": {
    "host": "0.0.0.0",
    "port": 8010
  },
  "runtime": {
    "run_log": "data/run_log.jsonl",
    "run_log_max_entries": 5000
  },
  "security": {
    "session_days": 7,
    "allow_registration": true,
    "upload_max_mb": 10,
    "allowed_upload_ext": [
      ".csv",
      ".xlsx",
      ".xls",
      ".json",
      ".txt"
    ]
  },
  "snapshot": {
    "blob_api_base": "https://blob.vercel-storage.com",
    "blob_api_version": "7",
    "prefix": "onti",
    "timeout_s": 20,
    "min_interval_s": 5,
    "blob_token_env": "BLOB_READ_WRITE_TOKEN",
    "http_url_env": "ONTI_SNAPSHOT_URL",
    "http_token_env": "ONTI_SNAPSHOT_TOKEN"
  }
}