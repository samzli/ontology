# ---------------------------------------------------------------------------
# Optional bootstrap for a default model.
#
# Models are configured in the application: Admin -> Model centre, where ANY
# OpenAI-compatible Chat Completions endpoint can be added (OpenAI, Azure
# gateways, DeepSeek, Moonshot, Together, vLLM, Ollama, LM Studio, etc.).
# No model is required for the rules engine, graph, library, imports or
# Markdown/HTML/PDF reports.
#
# On first startup only, if the variables below exist, they are imported once
# as the default (encrypted) model configuration. Afterwards, manage everything
# in the Model centre UI.
#
#   LLM_API_KEY    = API key / bearer token for your endpoint
#   LLM_BASE_URL   = OpenAI-compatible base URL, ending in /v1
#   LLM_MODEL_NAME = model id as expected by the endpoint
#
# Examples (pick ONE provider and fill in its values):
#
#   OpenAI            https://api.openai.com/v1                 gpt-4o-mini
#   DeepSeek          https://api.deepseek.com/v1               deepseek-chat
#   Moonshot (Kimi)   https://api.moonshot.cn/v1                moonshot-v1-8k
#   Together AI       https://api.together.xyz/v1               meta-llama/Llama-3-8b-chat-hf
#   Local Ollama      http://localhost:11434/v1                 llama3
#   Local vLLM/LM     http://localhost:8000/v1                  <served-model-name>
# ---------------------------------------------------------------------------
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL_NAME=your-model-id

# Legacy variables below are still read on first startup for backward
# compatibility only; prefer the generic LLM_* names above.
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL_NAME=
